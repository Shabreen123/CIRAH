        <!-- Tier 1: Box 2: STAGE 1: Failure Observation & Detection -->
        <mxCell id="t1_stage1" value="&lt;b&gt;STAGE 1&lt;br&gt;Failure Observation&lt;br&gt;&amp;amp; Detection&lt;/b&gt;&lt;hr style='margin:4px 0;'&gt;&lt;div style='text-align:left;padding-left:5px;'&gt;&amp;bull; Threshold anomaly trigger&lt;br&gt;&amp;bull; Multi-link congestion identifier&lt;br&gt;&amp;bull; SLA degradation isolation&lt;br&gt;&amp;bull; Flow impairment mapping&lt;br&gt;&amp;bull; Output: observed symptoms &amp;theta;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.5;align=center;verticalAlign=top;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1">
