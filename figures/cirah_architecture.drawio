        <!-- Tier 2: Box 1: STAGE 2: Structural Causal Model & Traceable Reasoning -->
        <mxCell id="t2_stage2" value="&lt;b&gt;STAGE 2&lt;br&gt;Structural Causal Model&lt;br&gt;&amp;amp; Traceable Reasoning&lt;/b&gt;&lt;hr style='margin:4px 0;'&gt;&lt;div style='text-align:left;padding-left:3px;'&gt;&amp;bull; Causal graph G = (V, E)&lt;br&gt;&amp;bull; Endogenous: X, L, Q, R, Y&lt;br&gt;&amp;bull; Exogenous noise: U_L, U_Q, U_Y&lt;br&gt;&amp;bull; Bayesian fault posterior&lt;br&gt;&amp;bull; P(E, t = &amp;theta; | X, U, A)&lt;br&gt;&amp;bull; Interven. options: counterfactuals&lt;br&gt;&amp;bull; True root cause localization&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.5;align=center;verticalAlign=top;fontFamily=Times New Roman;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="285" width="265" height="175" as="geometry" />
        </mxCell>

        <!-- Tier 2: Box 2: STAGE 3: Pearl Counterfactual Intervention Engine -->
        <mxCell id="t2_stage3" value="&lt;b&gt;STAGE 3&lt;br&gt;Pearl Counterfactual&lt;br&gt;Intervention Engine&lt;/b&gt;&lt;hr style='margin:4px 0;'&gt;&lt;div style='text-align:left;padding-left:3px;'&gt;&amp;bull; Candidate space A_c&lt;br&gt;&amp;bull; do(A) via backdoor (do-operator)&lt;br&gt;&amp;bull; K-shortest / k-paths (latency)&lt;br&gt;&amp;bull; Impact-rate scaling (&amp;beta;, r)&lt;br&gt;&amp;bull; Safety constraints&lt;br&gt;&amp;bull; P(A | do(X = x)) &amp;rarr; &amp;Delta; metric&lt;br&gt;&amp;bull; Policy set &amp;Pi; = {a_1, a_2, ..., a_m}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.5;align=center;verticalAlign=top;fontFamily=Times New Roman;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="285" width="265" height="175" as="geometry" />
        </mxCell>

        <!-- Tier 2: Box 3: STAGE 4: Causal Healing Field Propagator (CHFP) -->
        <mxCell id="t2_stage4" value="&lt;b&gt;STAGE 4&lt;br&gt;Causal Healing Field&lt;br&gt;Propagator (CHFP)&lt;/b&gt;&lt;hr style='margin:4px 0;'&gt;&lt;div style='text-align:left;padding-left:3px;'&gt;&amp;bull; Normal/abnormal graph Laplacian&lt;br&gt;&amp;bull; L_h = I + &amp;alpha;(I - W) (w &amp;prop; &amp;delta;)&lt;br&gt;&amp;bull; Steady-state heat diffusion&lt;br&gt;&amp;bull; h_t = h_i + &amp;Delta; &amp;bull; f(V_i, t)&lt;br&gt;&amp;bull; Edge / node weight updates&lt;br&gt;&amp;bull; Aggregate benefit: B(a) = &amp;sum; R(a, v)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.5;align=center;verticalAlign=top;fontFamily=Times New Roman;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="285" width="265" height="175" as="geometry" />
        </mxCell>

        <!-- Tier 2: Box 4: STAGE 5: Risk-Constrained Minimum-Intervention Solver -->
        <mxCell id="t2_stage5" value="&lt;b&gt;STAGE 5&lt;br&gt;Risk-Constrained&lt;br&gt;Minimum-Intervention Solver&lt;/b&gt;&lt;hr style='margin:4px 0;'&gt;&lt;div style='text-align:left;padding-left:3px;'&gt;&amp;bull; min &amp;sum; c_i &amp;bull; a_i, a_i &amp;isin; A, A = C&lt;br&gt;&amp;bull; BR_s (logics) &amp;rarr; R*&lt;br&gt;&amp;bull; A: P_CON(A) &amp;le; R_max&lt;br&gt;&amp;bull; P(E, &amp;pi;) dec(a) &amp;rarr; Connectivity(a) &amp;ge; &amp;tau;&lt;br&gt;&amp;bull; Multi-crit. value / fallback&lt;br&gt;&amp;bull; Output: action a*&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.5;align=center;verticalAlign=top;fontFamily=Times New Roman;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="910" y="285" width="255" height="175" as="geometry" />
