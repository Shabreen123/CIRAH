        <!-- Tier 1: Box 1: Network Telemetry Inputs -->
        <mxCell id="t1_inputs" value="&lt;b&gt;Network Telemetry&lt;br&gt;Data-Plane Inputs&lt;/b&gt;&lt;hr style='margin:4px 0;'&gt;&lt;div style='text-align:left;padding-left:5px;'&gt;&amp;bull; Dynamic topology (G = (V, E))&lt;br&gt;&amp;bull; Traffic demand matrix (D)&lt;br&gt;&amp;bull; Link latency &amp;amp; packet loss&lt;br&gt;&amp;bull; Buffer / queue depths (q)&lt;br&gt;&amp;bull; Pipe table counters&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.5;align=center;verticalAlign=top;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1">
