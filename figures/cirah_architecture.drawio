        <!-- ==================== TIER 1 CONTAINER ==================== -->
        <mxCell id="tier1_box" value="&lt;b&gt;TIER 1 — Telemetry Ingestion &amp;amp; Data-Plane Observation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#111111;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontFamily=Times New Roman;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1160" height="200" as="geometry" />
